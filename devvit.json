{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "swaad-nama",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "http": {
      "enable": true,
      "domains": ["photon.komoot.io", "basemaps.cartocdn.com"]
    },
    "reddit": true,
    "journeys": true
  },
  "menu": {
    "items": [
      {
        "label": "Create SwaadNama post",
        "description": "Post the SwaadNama hub to this subreddit",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      }
    ]
  },
  "settings": {
    "subreddit": {
      "appStatus": {
        "type": "select",
        "label": "App status",
        "helpText": "Open: everyone can use SwaadNama. Closed: members see \"Coming Soon\" on the post (the app admin can still use it, for testing).",
        "options": [
          {
            "label": "Open",
            "value": "open"
          },
          {
            "label": "Closed",
            "value": "closed"
          }
        ],
        "defaultValue": "open"
      },
      "mapArea": {
        "type": "string",
        "label": "Map area",
        "helpText": "City, state or country this subreddit covers, e.g. Pune or India. The map opens on it and place search prefers it.",
        "placeholder": "e.g. Pune",
        "defaultValue": "India"
      }
    },
    "global": {
      "cartoApiKey": {
        "type": "string",
        "label": "CARTO basemaps API key",
        "helpText": "Free key from carto.com/basemaps/apikey, used for the map tiles.",
        "isSecret": true
      }
    }
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "dev": {
    "subreddit": "swaad_nama_dev2"
  }
}
